# ---------------------------------------------------------------
# i-HR environment template
# Local development: copy to .env and run `php artisan key:generate`.
# Production: set these as environment variables on the host
# (e.g. Railway "Variables"), never commit a real .env file.
# ---------------------------------------------------------------

APP_NAME=i-HR
APP_ENV=local                 # production on the live server
APP_KEY=
APP_DEBUG=true                # MUST be false in production
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug               # warning (or error) in production

# --- Database (PostgreSQL) -------------------------------------
# Either set DATABASE_URL (Railway provides it) or the individual values.
DB_CONNECTION=pgsql
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ihr
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer             # require for a hosted database

# --- Network access (docs/DEPLOYMENT.md section 4) -----------
# Railway: X-Real-IP. Leave empty when not behind a proxy (local).
CLIENT_IP_HEADER=
# Office + VPN egress IPs / CIDR ranges. Empty = public (local, staging).
IP_ALLOWLIST=
# hr = HR area + HR accounts internal, applicant portal public (default) | all = whole site internal
IP_ALLOWLIST_SCOPE=hr

# --- First HR account (used by `php artisan db:seed`) -----------
# In production the seeder refuses to run without a 12+ character password.
HR_ADMIN_USERNAME=humanres
HR_ADMIN_EMAIL=hr@example.com
HR_ADMIN_PASSWORD=

# --- Sessions / cache / queue ----------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true    # cookie only sent over HTTPS (defaults to on when APP_URL is https://)
SESSION_SAME_SITE=lax

# Security (config/security.php, docs/SECURITY.md)
HR_IDLE_MINUTES=30            # HR is signed out after this long without activity
SECURITY_CSP=enforce          # enforce | report (log only) | off
SECURITY_HSTS_MAX_AGE=31536000

CACHE_STORE=database
# local: sync (jobs run inside the request, no worker needed)
# staging / production: database + a "worker" service (CONTAINER_ROLE=worker)
QUEUE_CONNECTION=sync

# Docker image role: web (HTTP + migrations) or worker (queue jobs). See docker/start.sh
CONTAINER_ROLE=web

BROADCAST_CONNECTION=log

FILESYSTEM_DISK=local

# Résumés and avatars (App\Services\Uploads)
# local: public (storage/app/public)    staging / production: s3 (private bucket, signed links)
UPLOADS_DISK=public

# --- Mail (interview invitations) ------------------------------
MAIL_MAILER=log               # smtp in production
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Google sign-in --------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# --- AI résumé parsing (OpenRouter / OpenAI compatible) --------
AI_PROVIDER=openrouter
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=openai/gpt-4o-mini
AI_HTTP_REFERRER="${APP_URL}"
AI_APP_NAME="${APP_NAME}"

# --- S3-compatible bucket (when UPLOADS_DISK=s3) -------------
# Railway Storage Bucket: copy from the bucket's Credentials tab.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=https://storage.railway.app
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ROOT=                     # optional folder prefix, e.g. staging

VITE_APP_NAME="${APP_NAME}"
